{
  "name": "rainstreak",
  "version": "1.0.0",
  "description": "Rain streak tracker by US zip code",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute rainstreak-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute rainstreak-db --remote --file=./migrations/0001_init.sql"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
